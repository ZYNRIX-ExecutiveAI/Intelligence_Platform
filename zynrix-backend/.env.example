# Copy this file to .env and fill in real values before starting the server.

# Required. A long, random string used to sign login sessions.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Port the API listens on.
PORT=4000

# Comma-separated list of origins allowed to call this API (your platform's
# and admin console's URLs). Use * only while testing locally.
CORS_ORIGIN=*

# Created once, the very first time the server starts with an empty database.
# Change this password immediately after your first login.
FIRST_ADMIN_NAME=Super Admin
FIRST_ADMIN_EMAIL=admin@zynrix.example
FIRST_ADMIN_PASSWORD=changeme123

# Default support email shown in Executive Hub settings.
DEFAULT_SUPPORT_EMAIL=hub-support@zynrix.example

# Where the SQLite database file and uploaded files are stored.
# On most hosts this MUST point at a persistent volume/disk — see README.md.
DATA_DIR=./data
UPLOAD_DIR=./uploads
